# Mari Lingo Bot - Конфигурация

# Telegram Bot Token
# Получить здесь: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API Key
# Получить здесь: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Путь к RAG базе данных
RAG_DB_PATH=./rag_database

# Путь для хранения данных пользователей
USER_DATA_PATH=./user_data

# Настройки бота
BOT_USERNAME=MariLingoBot
BOT_NAME=Mari Lingo Bot

# Лимиты
MAX_MESSAGE_LENGTH=4000
MAX_CONTEXT_CHUNKS=3

# Режим разработки (true/false)
DEBUG_MODE=false
