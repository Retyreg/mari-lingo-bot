# Mari Lingo Bot - Конфигурация

# Telegram Bot Token
# Получить здесь: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API Key (единая точка для всех LLM-провайдеров)
# Получить здесь: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Модель LLM. Примеры:
#   anthropic/claude-3.5-haiku        — дёшево, умно для русского (по умолчанию)
#   anthropic/claude-3.5-sonnet       — качество выше, дороже
#   meta-llama/llama-3.3-70b-instruct — для llama-моделей бот автоматически
#                                       пинит провайдера Groq для низкой latency
#   openai/gpt-4o-mini                — компромисс
LLM_MODEL=anthropic/claude-3.5-haiku

# Путь к RAG базе данных
RAG_DB_PATH=./rag_database
